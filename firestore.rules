rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite a cada usuario autenticado leer y escribir SOLO sus propios
    // datos: el documento raíz users/{uid} y TODAS sus subcolecciones
    // (tasks, taskLists, activities, timeSessions, calendarEvents).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
